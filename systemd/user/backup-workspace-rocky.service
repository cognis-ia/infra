[Unit]
Description=Backup diario workspace Rocky (git commit + push)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=WORKSPACE=/home/openclaw/.openclaw/workspace
Environment=AGENT_NAME=Rocky
ExecStart=/home/openclaw/.openclaw/workspace/skills/operacional/backup-workspace/scripts/run_backup.sh
WorkingDirectory=/home/openclaw/.openclaw/workspace
StandardOutput=journal
StandardError=journal
