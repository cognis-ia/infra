[Unit]
Description=Heartbeat por estado Gabi (LLM + contexto local)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=WORKSPACE=/home/openclaw/.openclaw/workspace-gabi
Environment=AGENT_ID=gabi
Environment=AGENT_NAME=Gabi
Environment=TELEGRAM_ACCOUNT=gabi
Environment=TELEGRAM_TO=1950767646
Environment=MODEL=openai-codex/gpt-5.4
Environment=THINKING=low
ExecStart=/home/openclaw/.openclaw/workspace/skills/operacional/heartbeat-runner/scripts/run_heartbeat.sh
WorkingDirectory=/home/openclaw/.openclaw/workspace-gabi
StandardOutput=journal
StandardError=journal
