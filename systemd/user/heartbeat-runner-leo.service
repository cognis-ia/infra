[Unit]
Description=Heartbeat por estado Leo (LLM + contexto local)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=WORKSPACE=/home/openclaw/.openclaw/workspace-leo
Environment=AGENT_ID=leo
Environment=AGENT_NAME=Leo
Environment=TELEGRAM_ACCOUNT=leo
Environment=TELEGRAM_TO=1950767646
Environment=MODEL=openai-codex/gpt-5.4
Environment=THINKING=low
ExecStart=/home/openclaw/.openclaw/workspace/skills/operacional/heartbeat-runner/scripts/run_heartbeat.sh
WorkingDirectory=/home/openclaw/.openclaw/workspace-leo
StandardOutput=journal
StandardError=journal
