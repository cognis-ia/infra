[Unit]
Description=Backup diario workspace Gabi (git commit + push)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=WORKSPACE=/home/openclaw/.openclaw/workspace-gabi
Environment=AGENT_NAME=Gabi
ExecStart=/home/openclaw/.openclaw/workspace/skills/operacional/backup-workspace/scripts/run_backup.sh
WorkingDirectory=/home/openclaw/.openclaw/workspace-gabi
StandardOutput=journal
StandardError=journal
