[Unit]
Description=Backup diario workspace Max (git commit + push)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=WORKSPACE=/home/openclaw/.openclaw/workspace-max
Environment=AGENT_NAME=Max
ExecStart=/home/openclaw/.openclaw/workspace/skills/operacional/backup-workspace/scripts/run_backup.sh
WorkingDirectory=/home/openclaw/.openclaw/workspace-max
StandardOutput=journal
StandardError=journal
