[Unit]
Description=Backup diario workspace BrIA (git commit + push)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=WORKSPACE=/home/openclaw/.openclaw/workspace-bria
Environment=AGENT_NAME=BrIA
ExecStart=/home/openclaw/.openclaw/workspace/skills/operacional/backup-workspace/scripts/run_backup.sh
WorkingDirectory=/home/openclaw/.openclaw/workspace-bria
StandardOutput=journal
StandardError=journal
